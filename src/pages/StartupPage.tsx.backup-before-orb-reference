import { useEffect, useRef } from 'react'
import { Canvas, useFrame } from '@react-three/fiber'
import gsap from 'gsap'
import * as THREE from 'three'
import { useNavigationStore } from '../store/navigation'

const BOOT_DURATION = 3800
const EXIT_DURATION = 500

function NexusCore() {
  const coreRef = useRef<THREE.Mesh>(null)
  const shellRef = useRef<THREE.Mesh>(null)
  const ringOneRef = useRef<THREE.Mesh>(null)
  const ringTwoRef = useRef<THREE.Mesh>(null)
  const ringThreeRef = useRef<THREE.Mesh>(null)
  const materialRef = useRef<THREE.MeshStandardMaterial>(null)

  useEffect(() => {
    const core = coreRef.current
    const shell = shellRef.current
    const ringOne = ringOneRef.current
    const ringTwo = ringTwoRef.current
    const ringThree = ringThreeRef.current
    const material = materialRef.current

    if (
      !core ||
      !shell ||
      !ringOne ||
      !ringTwo ||
      !ringThree ||
      !material
    ) {
      return
    }

    const context = gsap.context(() => {
      gsap.to(core.scale, {
        x: 1.035,
        y: 1.035,
        z: 1.035,
        duration: 2.1,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
      })

      gsap.to(shell.scale, {
        x: 1.08,
        y: 1.08,
        z: 1.08,
        duration: 2.8,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
      })

      gsap.to(material, {
        emissiveIntensity: 2.2,
        duration: 1.8,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
      })

      gsap.to(ringOne.rotation, {
        x: `+=${Math.PI * 2}`,
        duration: 8,
        ease: 'none',
        repeat: -1,
      })

      gsap.to(ringTwo.rotation, {
        y: `+=${Math.PI * 2}`,
        duration: 11,
        ease: 'none',
        repeat: -1,
      })

      gsap.to(ringThree.rotation, {
        z: `-=${Math.PI * 2}`,
        duration: 14,
        ease: 'none',
        repeat: -1,
      })
    })

    return () => {
      context.revert()
    }
  }, [])

  useFrame((state, delta) => {
    const time = state.clock.elapsedTime

    if (coreRef.current) {
      coreRef.current.rotation.y += delta * 0.16
      coreRef.current.rotation.x =
        Math.sin(time * 0.45) * 0.045
    }

    if (shellRef.current) {
      shellRef.current.rotation.y -= delta * 0.22
      shellRef.current.rotation.z =
        Math.sin(time * 0.32) * 0.08
    }
  })

  return (
    <group>
      <mesh ref={coreRef}>
        <icosahedronGeometry args={[1.02, 5]} />

        <meshStandardMaterial
          ref={materialRef}
          color="#4937e8"
          emissive="#176cff"
          emissiveIntensity={1.8}
          roughness={0.18}
          metalness={0.82}
          transparent
          opacity={0.97}
        />
      </mesh>

      <mesh ref={shellRef} scale={0.94}>
        <icosahedronGeometry args={[0.93, 3]} />

        <meshBasicMaterial
          color="#67e8f9"
          wireframe
          transparent
          opacity={0.34}
        />
      </mesh>

      <mesh
        ref={ringOneRef}
        rotation={[0.72, 0.22, 0]}
      >
        <torusGeometry args={[1.18, 0.016, 10, 160]} />

        <meshBasicMaterial
          color="#22d3ee"
          transparent
          opacity={0.58}
        />
      </mesh>

      <mesh
        ref={ringTwoRef}
        rotation={[-0.52, 0.7, 0.2]}
      >
        <torusGeometry args={[1.34, 0.012, 10, 160]} />

        <meshBasicMaterial
          color="#8b5cf6"
          transparent
          opacity={0.44}
        />
      </mesh>

      <mesh
        ref={ringThreeRef}
        rotation={[1.1, -0.4, 0.55]}
      >
        <torusGeometry args={[1.5, 0.008, 8, 160]} />

        <meshBasicMaterial
          color="#a78bfa"
          transparent
          opacity={0.25}
        />
      </mesh>

      <pointLight
        color="#8b5cf6"
        intensity={4.5}
        distance={4}
      />

      <pointLight
        color="#22d3ee"
        intensity={2.2}
        distance={3.5}
        position={[1.2, 0.6, 1.2]}
      />
    </group>
  )
}

export default function StartupPage() {
  const setCurrentView = useNavigationStore(
    (state) => state.setCurrentView,
  )

  const setBooted = useNavigationStore(
    (state) => state.setBooted,
  )

  const orbRef = useRef<HTMLDivElement>(null)
  const glowRef = useRef<HTMLDivElement>(null)

  useEffect(() => {
    if (!orbRef.current || !glowRef.current) {
      return
    }

    const orb = orbRef.current
    const glow = glowRef.current

    const context = gsap.context(() => {
      gsap.fromTo(
        orb,
        {
          opacity: 0,
          scale: 0.72,
          y: 8,
        },
        {
          opacity: 1,
          scale: 1,
          y: 0,
          duration: 1.15,
          ease: 'power4.out',
        },
      )

      gsap.fromTo(
        glow,
        {
          opacity: 0,
          scale: 0.72,
        },
        {
          opacity: 1,
          scale: 1,
          duration: 1.35,
          ease: 'power3.out',
        },
      )

      gsap.to(glow, {
        scale: 1.12,
        opacity: 0.9,
        duration: 2.2,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
      })
    })

    const exitTimer = window.setTimeout(() => {
      /*
       * The Home page already places the Nexus orb around 72% of
       * the viewport width. Move the startup orb toward that exact
       * visual area before changing the route.
       */
      gsap.to(orb, {
        x: '22vw',
        scale: 1.38,
        opacity: 1,
        duration: EXIT_DURATION / 1000,
        ease: 'power4.inOut',
      })

      gsap.to(glow, {
        x: '22vw',
        scale: 1.55,
        opacity: 0,
        duration: EXIT_DURATION / 1000,
        ease: 'power3.in',
      })

      /*
       * Do not depend on GSAP's ticker for the state change.
       * This also keeps fake-timer tests deterministic.
       */
      window.setTimeout(() => {
        setBooted(true)
        setCurrentView('home')
      }, EXIT_DURATION)
    }, BOOT_DURATION)

    return () => {
      window.clearTimeout(exitTimer)
      context.revert()
    }
  }, [setBooted, setCurrentView])

  return (
    <section
      data-testid="nexus-startup"
      className="fixed inset-0 z-[100] flex items-center justify-center overflow-hidden bg-[#02030a]"
    >
      <div
        ref={glowRef}
        aria-hidden="true"
        className="pointer-events-none absolute h-[260px] w-[260px] rounded-full bg-[radial-gradient(circle,rgba(34,211,238,0.22)_0%,rgba(79,70,229,0.18)_35%,rgba(124,58,237,0.08)_58%,transparent_75%)] blur-[42px] sm:h-[300px] sm:w-[300px]"
      />

      <div
        ref={orbRef}
        id="nexus-startup-orb"
        className="relative h-[220px] w-[220px] sm:h-[250px] sm:w-[250px]"
      >
        <Canvas
          camera={{
            position: [0, 0, 3.9],
            fov: 40,
          }}
          dpr={[1, 2]}
          gl={{
            antialias: true,
            alpha: true,
            powerPreference: 'high-performance',
          }}
        >
          <ambientLight intensity={0.18} />
          <NexusCore />
        </Canvas>
      </div>

      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,transparent_38%,rgba(2,3,10,0.42)_100%)]"
      />
    </section>
  )
}
