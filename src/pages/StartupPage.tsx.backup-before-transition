import { useEffect, useRef } from 'react'
import { Canvas, useFrame } from '@react-three/fiber'
import { motion } from 'framer-motion'
import gsap from 'gsap'
import * as THREE from 'three'
import { useNavigationStore } from '../store/navigation'

const BOOT_DURATION = 3800

function NexusCore() {
  const coreRef = useRef<THREE.Mesh>(null)
  const shellRef = useRef<THREE.Mesh>(null)
  const ringOneRef = useRef<THREE.Mesh>(null)
  const ringTwoRef = useRef<THREE.Mesh>(null)
  const ringThreeRef = useRef<THREE.Mesh>(null)
  const materialRef = useRef<THREE.MeshStandardMaterial>(null)

  useEffect(() => {
    if (!coreRef.current || !shellRef.current) {
      return
    }

    const core = coreRef.current
    const shell = shellRef.current

    const pulse = gsap.timeline({
      repeat: -1,
      yoyo: true,
    })

    pulse
      .to(core.scale, {
        x: 1.08,
        y: 1.08,
        z: 1.08,
        duration: 1.55,
        ease: 'sine.inOut',
      })
      .to(
        shell.scale,
        {
          x: 1.12,
          y: 1.12,
          z: 1.12,
          duration: 1.55,
          ease: 'sine.inOut',
        },
        0,
      )

    const glow = materialRef.current
      ? gsap.to(materialRef.current, {
          emissiveIntensity: 2.7,
          duration: 1.35,
          ease: 'sine.inOut',
          repeat: -1,
          yoyo: true,
        })
      : null

    const rings = [
      ringOneRef.current,
      ringTwoRef.current,
      ringThreeRef.current,
    ]

    const ringTweens = rings.map((ring, index) => {
      if (!ring) {
        return null
      }

      return gsap.to(ring.rotation, {
        z: `+=${index % 2 === 0 ? Math.PI * 2 : -Math.PI * 2}`,
        x: `+=${index === 1 ? -Math.PI * 2 : Math.PI * 2}`,
        duration: 7 + index * 2,
        ease: 'none',
        repeat: -1,
      })
    })

    return () => {
      pulse.kill()
      glow?.kill()
      ringTweens.forEach((tween) => tween?.kill())
    }
  }, [])

  useFrame((state, delta) => {
    const time = state.clock.elapsedTime

    if (coreRef.current) {
      coreRef.current.rotation.y += delta * 0.22
      coreRef.current.rotation.x = Math.sin(time * 0.35) * 0.08
    }

    if (shellRef.current) {
      shellRef.current.rotation.y -= delta * 0.34
      shellRef.current.rotation.z += delta * 0.12
    }
  })

  return (
    <group>
      <mesh ref={coreRef}>
        <icosahedronGeometry args={[0.82, 5]} />

        <meshStandardMaterial
          ref={materialRef}
          color="#8b5cf6"
          emissive="#6d28d9"
          emissiveIntensity={1.9}
          roughness={0.2}
          metalness={0.82}
          transparent
          opacity={0.96}
        />
      </mesh>

      <mesh ref={shellRef} scale={0.94}>
        <icosahedronGeometry args={[0.92, 3]} />

        <meshBasicMaterial
          color="#67e8f9"
          wireframe
          transparent
          opacity={0.3}
        />
      </mesh>

      <mesh
        ref={ringOneRef}
        rotation={[0.72, 0.22, 0]}
      >
        <torusGeometry args={[1.18, 0.018, 10, 160]} />

        <meshBasicMaterial
          color="#22d3ee"
          transparent
          opacity={0.55}
        />
      </mesh>

      <mesh
        ref={ringTwoRef}
        rotation={[-0.52, 0.7, 0.2]}
      >
        <torusGeometry args={[1.34, 0.012, 10, 160]} />

        <meshBasicMaterial
          color="#8b5cf6"
          transparent
          opacity={0.42}
        />
      </mesh>

      <mesh
        ref={ringThreeRef}
        rotation={[1.1, -0.4, 0.55]}
      >
        <torusGeometry args={[1.52, 0.008, 8, 160]} />

        <meshBasicMaterial
          color="#a78bfa"
          transparent
          opacity={0.24}
        />
      </mesh>

      <pointLight
        color="#8b5cf6"
        intensity={4.5}
        distance={4}
      />

      <pointLight
        color="#22d3ee"
        intensity={2.2}
        distance={3.5}
        position={[1.2, 0.6, 1.2]}
      />
    </group>
  )
}

export default function StartupPage() {
  const setCurrentView = useNavigationStore(
    (state) => state.setCurrentView,
  )

  const setBooted = useNavigationStore(
    (state) => state.setBooted,
  )

  const exitAnimationRef = useRef<gsap.core.Tween | null>(null)

  useEffect(() => {
    const intro = gsap.fromTo(
      '#nexus-startup-orb',
      {
        opacity: 0,
        scale: 0.72,
      },
      {
        opacity: 1,
        scale: 1,
        duration: 1.15,
        ease: 'power3.out',
      },
    )

    const finish = window.setTimeout(() => {
      exitAnimationRef.current = gsap.to(
        '#nexus-startup-orb',
        {
          opacity: 0,
          scale: 1.12,
          duration: 0.55,
          ease: 'power2.in',
          onComplete: () => {
            setBooted(true)
            setCurrentView('home')
          },
        },
      )
    }, BOOT_DURATION)

    return () => {
      intro.kill()
      window.clearTimeout(finish)
      exitAnimationRef.current?.kill()
    }
  }, [setBooted, setCurrentView])

  return (
    <section
      data-testid="nexus-startup"
      className="relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-[#02030a]"
    >
      <div className="pointer-events-none absolute inset-0">
        <div className="absolute left-1/2 top-1/2 h-[260px] w-[260px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-violet-600/[0.07] blur-[90px]" />

        <div className="absolute left-1/2 top-1/2 h-[150px] w-[150px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-400/[0.055] blur-[65px]" />
      </div>

      <motion.div
        id="nexus-startup-orb"
        className="relative h-[210px] w-[210px] sm:h-[240px] sm:w-[240px]"
        initial={{
          opacity: 0,
          scale: 0.72,
        }}
        animate={{
          opacity: 1,
          scale: 1,
        }}
        transition={{
          duration: 0.9,
          ease: [0.22, 1, 0.36, 1],
        }}
      >
        <Canvas
          camera={{
            position: [0, 0, 3.9],
            fov: 40,
          }}
          dpr={[1, 2]}
          gl={{
            antialias: true,
            alpha: true,
          }}
        >
          <ambientLight intensity={0.18} />
          <NexusCore />
        </Canvas>
      </motion.div>
    </section>
  )
}
