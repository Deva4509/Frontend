                          </button>

                          {memoryTypes.map(
                            ({
                              label,
                              icon: TypeIcon,
                            }) => (
                              <button
                                key={label}
                                onClick={() => {
                                  setSelectedType(label)
                                  setShowTypes(false)
                                }}
