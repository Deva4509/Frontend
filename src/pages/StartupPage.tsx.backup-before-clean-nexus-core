      >
        NEXUS
      </motion.div>

      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 0.055 }}
        transition={{
          duration: 2,
          delay: 0.15,
        }}
        className="absolute right-[-15vw] top-[53%] whitespace-nowrap text-[clamp(4rem,12vw,12rem)] font-semibold leading-none tracking-[-0.09em] text-violet-100"
      >
        INITIALISING
      </motion.div>

      <div className="absolute left-1/2 top-1/2 h-[48rem] w-[48rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-violet-700/[0.1] blur-[170px]" />

      <div className="absolute left-1/2 top-1/2 h-[25rem] w-[25rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-400/[0.055] blur-[120px]" />

      <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_8%,#020006_82%)]" />

