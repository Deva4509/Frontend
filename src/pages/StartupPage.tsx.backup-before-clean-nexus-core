import { useEffect, useMemo, useRef, useState } from 'react'
import { Canvas, useFrame } from '@react-three/fiber'
import { motion } from 'framer-motion'
import * as THREE from 'three'
import { useNavigationStore } from '../store/navigation'

const BOOT_DURATION = 3800
const EXIT_DURATION = 500

function EnergyParticles() {
  const pointsRef = useRef<THREE.Points>(null)

  const { positions, colors } = useMemo(() => {
    const count = 900
    const positionArray = new Float32Array(count * 3)
    const colorArray = new Float32Array(count * 3)

    for (let i = 0; i < count; i += 1) {
      const radius = 1.5 + Math.random() * 2.5
      const theta = Math.random() * Math.PI * 2
      const phi = Math.acos(2 * Math.random() - 1)

      positionArray[i * 3] =
        radius * Math.sin(phi) * Math.cos(theta)

      positionArray[i * 3 + 1] =
        radius * Math.sin(phi) * Math.sin(theta)

      positionArray[i * 3 + 2] =
        radius * Math.cos(phi)

      const cyan = Math.random() > 0.55

      colorArray[i * 3] = cyan ? 0.15 : 0.5
      colorArray[i * 3 + 1] = cyan ? 0.9 : 0.35
      colorArray[i * 3 + 2] = 1
    }

    return {
      positions: positionArray,
      colors: colorArray,
    }
  }, [])

  useFrame((state, delta) => {
    if (!pointsRef.current) return

    pointsRef.current.rotation.y += delta * 0.035
    pointsRef.current.rotation.x =
      Math.sin(state.clock.elapsedTime * 0.18) * 0.08
  })

  return (
    <points ref={pointsRef}>
      <bufferGeometry>
        <bufferAttribute
          attach="attributes-position"
          args={[positions, 3]}
        />
        <bufferAttribute
          attach="attributes-color"
          args={[colors, 3]}
        />
      </bufferGeometry>

      <pointsMaterial
        size={0.018}
        vertexColors
        transparent
        opacity={0.72}
        sizeAttenuation
        depthWrite={false}
      />
    </points>
  )
}

function OrbitalRing({
  radius,
  tube,
  rotation,
  speed,
  color,
  opacity,
}: {
  radius: number
  tube: number
  rotation: [number, number, number]
  speed: number
  color: string
  opacity: number
}) {
  const ref = useRef<THREE.Mesh>(null)

  useFrame((_, delta) => {
    if (!ref.current) return

    ref.current.rotation.z += delta * speed
  })

  return (
    <mesh
      ref={ref}
      rotation={rotation}
    >
      <torusGeometry
        args={[radius, tube, 12, 160]}
      />

      <meshBasicMaterial
        color={color}
        transparent
        opacity={opacity}
        toneMapped={false}
      />
    </mesh>
  )
}

function ScanningRing() {
  const ref = useRef<THREE.Mesh>(null)

  useFrame((state) => {
    if (!ref.current) return

    ref.current.rotation.z =
      state.clock.elapsedTime * 1.8

    const pulse =
      1 +
      Math.sin(state.clock.elapsedTime * 3.2) * 0.04

    ref.current.scale.setScalar(pulse)
  })

  return (
    <mesh ref={ref}>
      <torusGeometry
        args={[1.38, 0.008, 8, 128]}
      />

      <meshBasicMaterial
        color="#6ee7ff"
        transparent
        opacity={0.9}
        toneMapped={false}
      />
    </mesh>
  )
}

function NexusCore() {
  const coreRef = useRef<THREE.Mesh>(null)
  const shellRef = useRef<THREE.Mesh>(null)
  const wireRef = useRef<THREE.Mesh>(null)

  useFrame((state, delta) => {
    const time = state.clock.elapsedTime

    if (coreRef.current) {
      const pulse =
        0.43 +
        Math.sin(time * 2.4) * 0.045

      coreRef.current.scale.setScalar(pulse)

      coreRef.current.rotation.x += delta * 0.16
      coreRef.current.rotation.y -= delta * 0.3
    }

    if (shellRef.current) {
      const pulse =
        1 +
        Math.sin(time * 1.7) * 0.025

      shellRef.current.scale.setScalar(pulse)

      shellRef.current.rotation.x =
        Math.sin(time * 0.35) * 0.08

      shellRef.current.rotation.y +=
        delta * 0.12
    }

    if (wireRef.current) {
      wireRef.current.rotation.y -= delta * 0.24
      wireRef.current.rotation.z += delta * 0.07
    }
  })

  return (
    <group>
      <mesh ref={shellRef}>
        <icosahedronGeometry args={[1.12, 5]} />

        <meshPhysicalMaterial
          color="#16083f"
          emissive="#5526ff"
          emissiveIntensity={2.7}
          roughness={0.16}
          metalness={0.65}
          transmission={0.08}
          thickness={1.5}
          clearcoat={1}
          clearcoatRoughness={0.1}
          transparent
          opacity={0.9}
          toneMapped={false}
        />
      </mesh>

      <mesh ref={wireRef} scale={0.91}>
        <icosahedronGeometry args={[1.08, 3]} />

        <meshBasicMaterial
          color="#7048ff"
          wireframe
          transparent
          opacity={0.2}
          toneMapped={false}
        />
      </mesh>

      <mesh ref={coreRef}>
        <octahedronGeometry args={[1, 4]} />

        <meshPhysicalMaterial
          color="#e9ecff"
          emissive="#9d7aff"
          emissiveIntensity={5}
          roughness={0.08}
          metalness={0.2}
          transmission={0.2}
          clearcoat={1}
          toneMapped={false}
        />
      </mesh>

      <OrbitalRing
        radius={1.35}
        tube={0.012}
        rotation={[Math.PI / 2.2, 0.15, 0]}
        speed={0.55}
        color="#8b5cf6"
        opacity={0.75}
      />

      <OrbitalRing
        radius={1.5}
        tube={0.009}
        rotation={[0.9, 0.25, 0.7]}
        speed={-0.38}
        color="#22d3ee"
        opacity={0.62}
      />

      <OrbitalRing
        radius={1.68}
        tube={0.006}
        rotation={[1.8, -0.35, 0.15]}
        speed={0.25}
        color="#7c3aed"
        opacity={0.38}
      />

      <ScanningRing />

      <pointLight
        color="#7447ff"
        intensity={8}
        distance={5}
      />

      <pointLight
        color="#20e6ff"
        intensity={5}
        distance={4}
        position={[1.5, 0.6, 1]}
      />

      <pointLight
        color="#9d7aff"
        intensity={4}
        distance={3}
        position={[-1, -0.8, 0.8]}
      />
    </group>
  )
}

function OrbCanvas() {
  return (
    <Canvas
      camera={{
        position: [0, 0, 4.4],
        fov: 38,
      }}
      dpr={[1, 2]}
      gl={{
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
      }}
    >
      <ambientLight intensity={0.12} />

      <EnergyParticles />

      <NexusCore />
    </Canvas>
  )
}

