import { useEffect, useRef, useState } from 'react'
import { Canvas, useFrame } from '@react-three/fiber'
import { motion } from 'framer-motion'
import gsap from 'gsap'
import * as THREE from 'three'
import { useNavigationStore } from '../store/navigation'

const BOOT_DURATION = 4000
const EXIT_DURATION = 700

function NexusOrb() {
  const outerRef = useRef<THREE.Mesh>(null)
  const innerRef = useRef<THREE.Mesh>(null)
  const ringRef = useRef<THREE.Mesh>(null)
  const materialRef = useRef<THREE.MeshPhysicalMaterial>(null)

  useEffect(() => {
    const outer = outerRef.current
    const inner = innerRef.current
    const ring = ringRef.current
    const material = materialRef.current

    if (!outer || !inner || !ring || !material) {
      return
    }

    const outerScale = {
      x: 1,
      y: 1,
      z: 1,
    }

    const timeline = gsap.timeline({
      repeat: -1,
      yoyo: true,
    })

    timeline
      .to(
        outerScale,
        {
          x: 1.055,
          y: 0.94,
          z: 1.04,
          duration: 1.65,
          ease: 'sine.inOut',
          onUpdate: () => {
            outer.scale.set(
              outerScale.x,
              outerScale.y,
              outerScale.z,
            )
          },
        },
      )
      .to(
        outerScale,
        {
          x: 0.94,
          y: 1.055,
          z: 0.97,
          duration: 1.85,
          ease: 'sine.inOut',
          onUpdate: () => {
            outer.scale.set(
              outerScale.x,
              outerScale.y,
              outerScale.z,
            )
          },
        },
      )

    const innerAnimation = gsap.to(inner.scale, {
      x: 1.09,
      y: 0.93,
      z: 1.08,
      duration: 1.8,
      ease: 'sine.inOut',
      repeat: -1,
      yoyo: true,
    })

    const ringAnimation = gsap.to(ring.rotation, {
      z: Math.PI * 2,
      duration: 8,
      ease: 'none',
      repeat: -1,
    })

    const glowAnimation = gsap.to(material, {
      emissiveIntensity: 2.9,
      roughness: 0.2,
      duration: 1.7,
      ease: 'sine.inOut',
      repeat: -1,
      yoyo: true,
    })

    return () => {
      timeline.kill()
      innerAnimation.kill()
      ringAnimation.kill()
      glowAnimation.kill()
    }
  }, [])

  useFrame((state, delta) => {
    const time = state.clock.elapsedTime

    if (outerRef.current) {
      outerRef.current.rotation.y += delta * 0.2
      outerRef.current.rotation.x =
        Math.sin(time * 0.42) * 0.06
      outerRef.current.rotation.z =
        Math.cos(time * 0.31) * 0.035
    }

    if (innerRef.current) {
      innerRef.current.rotation.y -= delta * 0.34
      innerRef.current.rotation.x += delta * 0.08
    }

    if (ringRef.current) {
      ringRef.current.rotation.x =
        Math.PI / 2.15 +
        Math.sin(time * 0.45) * 0.16
      ringRef.current.rotation.y =
        Math.cos(time * 0.35) * 0.2
    }
  })

  return (
    <group>
      <mesh ref={outerRef}>
        <icosahedronGeometry args={[1.18, 5]} />

        <meshPhysicalMaterial
          ref={materialRef}
          color="#24116d"
          emissive="#3920b8"
          emissiveIntensity={2.2}
          roughness={0.18}
          metalness={0.48}
          transmission={0.16}
          thickness={1.4}
          clearcoat={1}
          clearcoatRoughness={0.12}
          transparent
          opacity={0.96}
        />
      </mesh>

      <mesh ref={innerRef} scale={0.82}>
        <icosahedronGeometry args={[1, 4]} />

        <meshBasicMaterial
          color="#5534ff"
          wireframe
          transparent
          opacity={0.12}
        />
      </mesh>

      <mesh
        ref={ringRef}
        rotation={[Math.PI / 2.15, 0, 0]}
      >
        <torusGeometry
          args={[1.28, 0.018, 16, 160]}
        />

        <meshBasicMaterial
          color="#35dfff"
          transparent
          opacity={0.7}
        />
      </mesh>

      <mesh scale={0.46}>
        <octahedronGeometry args={[1, 2]} />

        <meshPhysicalMaterial
          color="#d8dcff"
          emissive="#8b5cf6"
          emissiveIntensity={3}
          roughness={0.12}
          metalness={0.15}
          transmission={0.25}
          clearcoat={1}
        />
      </mesh>

      <pointLight
        color="#6d4aff"
        intensity={7}
        distance={5}
      />

      <pointLight
        color="#18dfff"
        intensity={4}
        distance={4}
        position={[1.4, 0.5, 1.2]}
      />

      <pointLight
        color="#8b5cf6"
        intensity={3}
        distance={3}
        position={[-1.2, -0.7, 0.8]}
      />
    </group>
  )
}

function OrbCanvas() {
  return (
    <Canvas
      camera={{
        position: [0, 0, 4],
        fov: 38,
      }}
      dpr={[1, 2]}
      gl={{
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
      }}
    >
      <ambientLight intensity={0.18} />
      <NexusOrb />
    </Canvas>
  )
}

function BackgroundTypography() {
  return (
    <div
      aria-hidden="true"
      className="pointer-events-none absolute inset-0 overflow-hidden"
    >
      <motion.div
        initial={{
          opacity: 0,
          x: -80,
        }}
        animate={{
          opacity: 0.16,
          x: 0,
        }}
        transition={{
          duration: 1.4,
          ease: [0.22, 1, 0.36, 1],
        }}
        className="absolute left-[-3vw] top-[34%] whitespace-nowrap text-[clamp(4rem,10vw,10rem)] font-semibold leading-none tracking-[-0.075em] text-white"
      >
        NEXUS
      </motion.div>

      <motion.div
        initial={{
          opacity: 0,
          x: 80,
        }}
        animate={{
          opacity: 0.13,
          x: 0,
        }}
        transition={{
          duration: 1.4,
          delay: 0.08,
          ease: [0.22, 1, 0.36, 1],
        }}
        className="absolute right-[-8vw] top-[48%] whitespace-nowrap text-[clamp(4rem,10vw,10rem)] font-semibold leading-none tracking-[-0.075em] text-violet-100"
      >
        INITIALISING
      </motion.div>
    </div>
  )
}

export default function StartupPage() {
  const setCurrentView = useNavigationStore(
    (state) => state.setCurrentView,
  )

  const setBooted = useNavigationStore(
    (state) => state.setBooted,
  )

  const [isExiting, setIsExiting] = useState(false)

  const exitTimerRef = useRef<number | null>(null)

  useEffect(() => {
    const progress = {
      value: 0,
    }

    const bootAnimation = gsap.to(progress, {
      value: 100,
      duration: BOOT_DURATION / 1000,
      ease: 'power2.inOut',
      onComplete: () => {
        setIsExiting(true)

        exitTimerRef.current = window.setTimeout(() => {
          setBooted(true)
          setCurrentView('home')
        }, EXIT_DURATION)
      },
    })

    return () => {
      bootAnimation.kill()

      if (exitTimerRef.current !== null) {
        window.clearTimeout(exitTimerRef.current)
      }
    }
  }, [setBooted, setCurrentView])

  const canRenderWebGL =
    typeof window !== 'undefined' &&
    'ResizeObserver' in window

  return (
    <motion.section
      data-testid="nexus-startup"
      initial={{
        opacity: 0,
      }}
      animate={{
        opacity: isExiting ? 0 : 1,
        scale: isExiting ? 1.06 : 1,
      }}
      transition={{
        opacity: {
          duration: isExiting
            ? EXIT_DURATION / 1000
            : 0.8,
          ease: 'easeInOut',
        },
        scale: {
          duration: EXIT_DURATION / 1000,
          ease: [0.76, 0, 0.24, 1],
        },
      }}
      className="relative z-10 flex min-h-screen w-full items-center justify-center overflow-hidden bg-[#050014] text-white"
    >
      <div className="pointer-events-none absolute inset-0">
        <div className="absolute left-1/2 top-1/2 h-[42rem] w-[42rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-violet-700/[0.13] blur-[150px]" />

        <div className="absolute left-1/2 top-1/2 h-[22rem] w-[22rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-400/[0.07] blur-[100px]" />

        <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_20%,#050014_78%)]" />
      </div>

      <BackgroundTypography />

      <motion.div
        initial={{
          opacity: 0,
          scale: 0.82,
          filter: 'blur(16px)',
        }}
        animate={{
          opacity: 1,
          scale: isExiting ? 1.12 : 1,
          filter: 'blur(0px)',
        }}
        transition={{
          duration: 1.5,
          ease: [0.16, 1, 0.3, 1],
        }}
        className="relative z-20 h-[min(58vw,520px)] w-[min(58vw,520px)]"
      >
        {canRenderWebGL ? (
          <OrbCanvas />
        ) : (
          <div
            aria-hidden="true"
            className="h-full w-full rounded-full bg-[radial-gradient(circle_at_35%_30%,#8b5cf6_0%,#4c1d95_28%,#160b45_58%,#050014_78%)] shadow-[0_0_100px_rgba(109,40,217,0.65)]"
          />
        )}
      </motion.div>

      <motion.div
        initial={{
          opacity: 0,
        }}
        animate={{
          opacity: 0.32,
        }}
        transition={{
          delay: 0.6,
          duration: 1.2,
        }}
        className="pointer-events-none absolute bottom-[9%] left-1/2 z-30 -translate-x-1/2 whitespace-nowrap"
      >
        <span className="font-mono text-[8px] uppercase tracking-[0.55em] text-violet-200">
          NEXUS INITIALISING
        </span>
      </motion.div>
    </motion.section>
  )
}
